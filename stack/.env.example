# Shared settings for every service in the media stack. No secrets here (those come from
# 1Password via <svc>/secrets.env.tpl). deploy.sh copies this file to .env on the VM only if
# .env is absent there, so edits made to .env on the VM survive redeploys.

# uid/gid that owns /data and the config dirs (user "media" on the VM)
PUID=1000
PGID=1000
# group-writable files, so every container (same group) can hardlink and move them
UMASK=002
# container time zone
TZ=America/Chicago
# single /data tree (TRaSH layout): /data/torrents/<type> and /data/media/<type>, mounted as /data
DATA_ROOT=/data
# per-service config/state lives in ${CONFIG_ROOT}/<service>
CONFIG_ROOT=/opt/media-stack/config
