# Provider auth for `op run --env-file .env.op -- terraform ...` (only op:// references here).
# Vault "Lab" = xmjfgnsondcvlqa6bovelwdztm; the Vultr item lives in vault y2gzkuozzzojcdddk25gspbe3m
# (same 1Password account).

# Vultr API key (item "Vultr", field "api key"). Quoted because the label has a space; swap the
# label for the field id when convenient (see README.md, "1Password items").
VULTR_API_KEY="op://y2gzkuozzzojcdddk25gspbe3m/4kfc3hdgfzuaq6t2pebm6err54/api key"

# Tailscale OAuth client (item "tailscale-terraform", created by hand during the bootstrap)
TAILSCALE_OAUTH_CLIENT_ID=op://xmjfgnsondcvlqa6bovelwdztm/tailscale-terraform/client_id
TAILSCALE_OAUTH_CLIENT_SECRET=op://xmjfgnsondcvlqa6bovelwdztm/tailscale-terraform/client_secret

# Logins/emails that the tailnet policy names (JSON object, placeholder -> value). The repo is
# public, so they live only in 1Password; policy.base.json.tftpl refers to them as ${id.<name>}.
TF_VAR_policy_identities=op://xmjfgnsondcvlqa6bovelwdztm/tailscale-terraform/policy_identities
