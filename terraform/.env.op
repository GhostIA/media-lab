# Provider auth for `op run --env-file .env.op -- terraform ...` (only op:// references here).
PROXMOX_VE_ENDPOINT=op://xmjfgnsondcvlqa6bovelwdztm/pve-terraform/endpoint
# api_token = "terraform@pve!media=<secret>" (op run cannot concatenate two references)
PROXMOX_VE_API_TOKEN=op://xmjfgnsondcvlqa6bovelwdztm/pve-terraform/api_token
# PVE uses its self-signed certificate
PROXMOX_VE_INSECURE=true
